# Development-only API route in this Next.js app.
# Copy this file to .env.local for local use. Do not use these values on VPS.
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Local API is enabled only when NODE_ENV=development and the request host is localhost.
LOCAL_API_ENABLED=true
LOCAL_API_EMAIL=master@mtsn2kk.sch.id
LOCAL_API_PASSWORD=ganti-dengan-password-lokal
LOCAL_API_USERNAME=Master Lokal

# URL Frontend (untuk share link, dll.)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
